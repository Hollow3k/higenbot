DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
GROQ_API_KEY=gsk_...
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_JWT_SECRET=your_jwt_secret
GEMINI_API_KEY=your_gemini_key
# NVIDIA NIM — used for all LLM nodes (moonshotai/kimi-k3)
NVIDIA_API_KEY=nvapi-...
# Optional overrides (defaults shown):
# NVIDIA_MODEL=moonshotai/kimi-k3
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# PLANNER_MAX_TOKENS=16000
# PROGRAMMER_MAX_TOKENS=32000
# PLANNER_REASONING_EFFORT=max
# PROGRAMMER_REASONING_EFFORT=max
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
